# הכסף שלנו — what does NOT belong in the repository

# the pipeline's work area and its fetched reports: build inputs, cached
# between CI runs (and rebuilt locally), never source
pipeline/build/
pipeline/reports/

# parsed full records: every column of every row, ~240 MB/month — they ship
# as a workflow artifact, never through git history (the lean documents in
# pipeline/paid ARE committed: merge base + never-shrink baseline)
pipeline/paid/*.full.json

# the local build's inputs and output live in pipeline/contractors/inputs
# and /out — covered by pipeline/contractors/.gitignore

# the D1/KV config — it holds an API TOKEN. Never in git.
/pipeline/d1-config.json

# leftovers from clean-up .bats (moved, not deleted, until Mercy empties it)
_old_delete_me/
*.log

# editors and office apps
.~lock.*#
~$*
*.tmp

# node
node_modules/
package-lock.json

# python
__pycache__/
*.pyc
.venv/

# screenshots the Playwright tests write next to themselves
site/tests/*.png
pipeline/tests/*.png

# Claude's working notes and drafts — never published with the repo
Claude outputs/

# Claude's notes (CLAUDE.md, NOTES.md, …) are its memory on this computer
# only — the repository publishes README.md alone (Mercy)
*.md
!/README.md
